{
    "tasks": {
        "clean": "rm -rf ./dist ./node_modules",
        "install": "deno install --frozen",
        "check": "deno check",
        "format": "deno fmt --check",
        "lint": "deno lint",
        "test": "vitest run",
        "test-update": "vitest run --update",
        "dev": "vite --host",
        "build": "vite build",
        "preview": {
            "command": "vite preview",
            "dependencies": ["build"]
        },
        "deploy": "wrangler pages deploy"
    },
    "imports": {
        "@alpinejs/persist": "npm:@alpinejs/persist@3.15.3",
        "@vite-pwa/assets-generator": "npm:@vite-pwa/assets-generator@1.0.2",
        "alpinejs": "npm:alpinejs@3.15.3",
        "hls.js": "npm:hls.js@1.6.15",
        "sass": "npm:sass@1.97.2",
        "simpledotcss": "npm:simpledotcss@2.3.7",
        "vite": "npm:vite@7.3.1",
        "vite-plugin-html-inject": "npm:vite-plugin-html-inject@1.1.2",
        "vite-plugin-pwa": "npm:vite-plugin-pwa@1.2.0",
        "vitest": "npm:vitest@4.0.16",
        "wrangler": "npm:wrangler@4.58.0"
    },
    "allowScripts": ["npm:@parcel/watcher@2.5.1", "npm:esbuild@0.27.0", "npm:sharp@0.33.5", "npm:workerd@1.20260107.1"],
    "nodeModulesDir": "auto",
    "lint": {
        "rules": {
            "tags": ["recommended"],
            "include": ["no-console"]
        }
    },
    "fmt": {
        "useTabs": false,
        "lineWidth": 120,
        "indentWidth": 4,
        "semiColons": true,
        "singleQuote": false,
        "newLineKind": "auto",
        "proseWrap": "preserve",
        "trailingCommas": "never",
        "useBraces": "always",
        "exclude": ["**/*.md", "**/*.svg", "**/.github/**/*.yml"]
    }
}
